/* todooit look: dark palette, rounded borders, accent border on focus.
   Palette variables ($background1, $red, ...) come from tcal/ui/theme.py. */

$border_type: round;

Screen {
    background: $background1;
    color: $foreground3;
}

#sidebar {
    width: 28;
}

#main {
    width: 1fr;
}

MiniCal, CalendarList, ViewSwitcher, #views > * {
    background: $background1;
    border: $border_type $background3;
    border-title-color: $foreground1;
    border-title-background: $background1;
    padding: 0 1;

    &:focus {
        border: $border_type $primary;
    }
}

#views > MonthView {
    padding: 0;  /* week separators run into the border */
}

MiniCal {
    height: 10;
}

CalendarList {
    height: 1fr;
}

ViewSwitcher {
    height: 3;
}

#views {
    height: 1fr;
}

StatusBar {
    height: 1;
    background: $background2;
    color: $foreground3;
}

* {
    scrollbar-size: 0 1;
    scrollbar-background: $background3;
    scrollbar-color: $primary;
    scrollbar-background-hover: $background2;
    scrollbar-color-hover: $secondary;
    scrollbar-background-active: $background2;
    scrollbar-color-active: $secondary;
}

/* ----- time grid (Day/Week views, tcal/ui/widgets/timegrid.py) -----
   The grid paints every cell itself from app.palette; the axis is its left margin. */

#views > DayView, #views > WeekView {
    padding: 0;
}

/* ----- help (tcal/ui/screens/help.py): todooit's key-bindings panel ----- */

HelpScreen {
    align: center middle;
    background: $background1 70%;

    & > #help-panel {
        width: 70;
        max-width: 90%;
        height: auto;
        max-height: 85%;
        background: $background2;
        border: $border_type $secondary;
        border-title-background: $primary;
        border-title-color: $background1;
        border-title-align: center;
        padding: 0 1;
        scrollbar-size-vertical: 1;
    }

    & > #help-hint {
        width: 70;
        max-width: 90%;
        color: $foreground1 60%;
        text-align: center;
    }
}

KeyTable {
    background: $background2;
    color: $foreground3;

    & > .keytable--key {
        color: $primary;
        text-style: bold;
    }

    & > .keytable--title {
        color: $secondary;
        text-style: bold;
    }

    & > .keytable--separator {
        color: $background3;
    }
}

/* ----- go to date / search (tcal/ui/screens/goto.py, search.py) ----- */

GotoScreen, SearchScreen {
    align: center top;
    background: $background1 50%;
}

GotoScreen Input, SearchScreen Input, SearchScreen OptionList {
    background: $background2;
    border: $border_type $primary;
    border-title-color: $foreground1;
    border-subtitle-color: $red;
}

GotoScreen Input {
    width: 60;
    margin-top: 3;
}

#search {
    width: 90;
    height: 80%;
    margin-top: 3;
}

SearchScreen OptionList {
    height: 1fr;
    border: $border_type $background3;
    border-subtitle-color: $foreground2;

    &:focus {
        border: $border_type $primary;
    }
}

/* ----- modals (tcal/ui/screens/) ----- */

EventDetail, ScopeDialog, EventForm {
    align: center middle;
    background: $background1 60%;
}

EventDetail #dialog, ScopeDialog #dialog {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $background2;
    border: $border_type $primary;
    padding: 1 2;
}

EventDetail #dialog > Static {
    margin-bottom: 1;
}

EventDetail #dialog > #hints {
    margin-bottom: 0;
}

ScopeDialog #buttons {
    height: auto;
    margin-top: 1;

    Button {
        margin-right: 1;
    }
}

/* event form (tcal/ui/screens/event_form.py) */

#form {
    width: 64;
    height: auto;
    max-height: 100%;
    background: $background2;
    border: $border_type $primary;
    border-title-color: $foreground3;
    border-title-background: $background2;
    padding: 0 1;

    Input, SelectCurrent, TextArea, Checkbox {
        background: $background2;
        border: $border_type $background3;
        &:focus { border: $border_type $primary; }
    }
    Select:focus > SelectCurrent { border: $border_type $primary; }
    .row { height: auto; }
    .label { width: 6; padding: 1 0 0 1; color: $foreground1; }
    #start_date, #end_date { width: 1fr; }
    .time { width: 12; }
    #notes { height: 5; }
    #error { color: $red; height: auto; }
    #hint { color: $foreground1; }
}
