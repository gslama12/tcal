/* todooit look: dark palette, rounded borders, accent border on focus.
   Palette variables ($background1, $red, ...) come from tcal/ui/theme.py. */

$border_type: round;

Screen {
    background: $background1;
    color: $foreground3;
}

#sidebar {
    width: 28;
}

#main {
    width: 1fr;
}

MiniCal, CalendarList, ViewSwitcher, #views > * {
    background: $background1;
    border: $border_type $background3;
    border-title-color: $foreground1;
    border-title-background: $background1;
    padding: 0 1;

    &:focus {
        border: $border_type $primary;
    }
}

MiniCal {
    height: 10;
}

CalendarList {
    height: 1fr;
}

ViewSwitcher {
    height: 3;
}

#views {
    height: 1fr;
}

StatusBar {
    height: 1;
    background: $background2;
    color: $foreground3;
}

* {
    scrollbar-size: 0 1;
    scrollbar-background: $background3;
    scrollbar-color: $primary;
    scrollbar-background-hover: $background2;
    scrollbar-color-hover: $secondary;
    scrollbar-background-active: $background2;
    scrollbar-color-active: $secondary;
}

/* ----- time grid (Day/Week views, tcal/ui/widgets/timegrid.py) -----
   The grid paints every cell itself from app.palette; the axis is its left margin. */

#views > DayView, #views > WeekView {
    padding: 0;
}

/* ----- help (tcal/ui/screens/help.py): todooit's key-bindings panel ----- */

HelpScreen {
    align: center middle;
    background: $background1 70%;

    & > #help-panel {
        width: 70;
        max-width: 90%;
        height: auto;
        max-height: 85%;
        background: $background2;
        border: $border_type $secondary;
        border-title-background: $primary;
        border-title-color: $background1;
        border-title-align: center;
        padding: 0 1;
        scrollbar-size-vertical: 1;
    }

    & > #help-hint {
        width: 70;
        max-width: 90%;
        color: $foreground1 60%;
        text-align: center;
    }
}

KeyTable {
    background: $background2;
    color: $foreground3;

    & > .keytable--key {
        color: $primary;
        text-style: bold;
    }

    & > .keytable--title {
        color: $secondary;
        text-style: bold;
    }

    & > .keytable--separator {
        color: $background3;
    }
}
